# ─── YATICORP LMS — student web app ──────────────────────────────────────────
# Copy to .env for local development. In production set this in the Vercel
# project's Environment Variables.
#
# IMPORTANT: Vite bakes this value into the bundle at BUILD time, not run time.
# Changing it requires a redeploy — restarting is not enough.
# If it is missing, the app silently falls back to http://localhost:5000/api
# and the deployed site will not work.
#
# Must include the /api suffix. No trailing slash.

# local:      http://localhost:5000/api
# production: https://<your-api-host>/api
VITE_API_URL=http://localhost:5000/api
