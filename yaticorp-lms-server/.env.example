# ─── YATICORP LMS — server environment ───────────────────────────────────────
# Copy to .env for local development, and set the same keys in your host's
# environment settings for production. Never commit the real .env.

# ─── Core (required) ─────────────────────────────────────────────────────────
PORT=5000
# Full connection string INCLUDING the database name at the end.
# The db name matters: pointing at a non-existent name silently creates an
# empty database and every login will fail with "invalid credentials".
MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/yati_lms"
# Long random string. Changing it invalidates every issued login token.
JWT_SECRET=<random-64-char-string>

# ─── CORS (required in production) ───────────────────────────────────────────
# The deployed frontend URLs. A mismatch here blocks every API call from the
# browser. No trailing slash. localhost is always allowed automatically.
FRONTEND_URL=https://<student-app>.vercel.app
ADMIN_URL=https://<admin-app>.vercel.app
# Optional extra origins, comma-separated (custom domains, preview URLs).
ALLOWED_ORIGINS=https://<student-app>.vercel.app,https://<admin-app>.vercel.app

# ─── Sync webhook (STRONGLY recommended) ─────────────────────────────────────
# Shared secret for POST /api/sync/activate, which creates active users and
# enrollments. While this is UNSET the endpoint accepts unauthenticated
# requests from anyone. Set it here AND make the main website send the same
# value as an `x-sync-key` header — set it in only one place and activations
# will start failing with 401.
SYNC_API_KEY=

# ─── Email (Brevo) ───────────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
ADMIN_EMAIL=

# ─── Media / storage ─────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_CDN_HOST=
BUNNY_STORAGE_HOST=

# Max size (MB) for a lesson video/PDF upload. Default 5120 (5 GB).
MAX_LESSON_UPLOAD_MB=

# ─── Video DRM ───────────────────────────────────────────────────────────────
VDOCIPHER_API_KEY=

# ─── CAREER PATH (FuturePath) ────────────────────────────────────────────────
# The student-only AI career-roadmap section at /api/career. Ported from the
# standalone FuturePath app; it reuses the LMS student login and MONGO_URI, so
# these are the only extra variables it needs.

# Google Gemini. Required — roadmaps, daily tasks, lessons and the AI mentor all
# fail without it. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Free-tier quota is per-day PER MODEL: the newest flash models allow
# only ~20 requests/day and a single onboarding costs 3, so the default here is
# the far more generous lite model. Override only if you have billing enabled.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional but worth setting. Without it, a task lesson links out to a YouTube
# SEARCH instead of embedding a video the student can watch in place — the
# lesson still works, it is just a worse one. Free: enable the YouTube Data API
# v3 at https://console.cloud.google.com/apis/library/youtube.googleapis.com
# and create an API key. The server logs a warning at startup while it is unset.
YOUTUBE_API_KEY=

# ─── Career Path AI budget ───────────────────────────────────────────────────
# The Gemini free tier is metered per day, per model. One onboarding costs three
# calls, so a cohort arriving together can spend the day's allowance before
# anyone asks the mentor a question. These caps make that failure bounded and
# honest rather than sudden and total — they are not a substitute for billing.

# Per student, per day. Generous enough for onboarding plus a full day of
# planning and mentoring. Raise it if the admin Career Path page shows students
# hitting it while doing normal work.
CAREER_AI_DAILY_PER_STUDENT=30

# Whole-service ceiling per day. 0 disables it, which is the default: a wrong
# number here locks out every student at once, and the right number depends on
# a billing plan only you know.
CAREER_AI_DAILY_TOTAL=0

# Where this API is reachable from the public internet. Used to build Career
# Path milestone-badge share links (/b/<code>), which students post to LinkedIn
# and WhatsApp. Falls back to the request's forwarded host, which is usually
# right — but a share link is permanent, so set this explicitly in production.
# No trailing slash. e.g. https://api.yaticorp.com
PUBLIC_API_URL=


# ─── JOBS (CareerCompass) ────────────────────────────────────────────────────
# The student job board at /api/jobs. Ported from the standalone CareerCompass
# app; it reuses the LMS student login and MONGO_URI, storing its listings in
# jobboard_* collections in the same database.
#
# Everything below is OPTIONAL. With none of it set the board still works: the
# index is built from employers' own boards (Greenhouse and Ashby, listed in
# src/jobboard/data/companies.js) plus Remotive and Arbeitnow, all keyless.
#
# Populate the index before students use it:
#   npm run jobs:seed      # role taxonomy — run once
#   npm run jobs:ingest    # pull listings
#   npm run jobs:geocode   # resolve place names so distance ranking works
#   npm run jobs:setup     # all three, in order
#
# After that first fill the server keeps the index alive by itself: a nightly
# maintenance run (scheduled in server.js) re-ingests every source, retires
# listings not seen for 45 days, and geocodes new place names. Set this to
# false only if the host runs a real cron for `npm run jobs:ingest` instead,
# or spins up many short-lived instances.
# JOBS_AUTO_INGEST=true

# --- JSearch (RapidAPI) -----------------------------------------------------
# What the keyless sources cannot do is answer "what is hiring near THIS town".
# They publish wherever the employer has an office, which in practice means
# tier-1 cities — read every board in the registry and you get Bengaluru,
# Hyderabad and Pune, and nothing at all in Mangalore, Udupi or Mysore.
# JSearch reads Google for Jobs, so it reaches tier-2 and tier-3 cities.
#
# Get the key: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Then pull a specific city:
#   node src/jobboard/scripts/ingest.js "developer" --in="Mangalore, India"
JSEARCH_RAPIDAPI_KEY=

# Requests are rationed rather than made freely — set these to match your own
# RapidAPI plan. Spend is counted in MongoDB, so it survives restarts.
# JSEARCH_MONTHLY_LIMIT=180
# JSEARCH_CALLS_PER_RUN=1

# --- Adzuna -----------------------------------------------------------------
# The alternative to JSearch, and either one is enough. Also city-radius capable
# with a more generous free tier, but it covers 19 countries rather than
# wherever Google indexes. Free, no card: https://developer.adzuna.com/signup
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# --- Semantic matching ------------------------------------------------------
# The job board's third matching signal. The other signals are literal —
# skills compare vocabulary, role compares words in the title — and both miss
# a React developer against a Vue job describing identical work. The nightly
# maintenance run keeps the vectors current automatically (up to 500 new or
# reworded listings per night); `npm run jobs:embed` works through a backlog
# by hand. Leave everything unset and the four deterministic signals are
# reweighted to sum to 1; results stay correct, just more literal.
#
# WITHOUT the key below, embeddings reuse GEMINI_API_KEY — the same key
# Career Path's mentor, roadmaps and daily tasks run on. Google meters per
# PROJECT per day, so job-board embedding spend and mentor conversations
# draw one shared allowance, and a large embed run can starve the mentor
# mid-class. Set a key from a SEPARATE Google Cloud project here and the two
# never touch: when any JOBS_GEMINI_* key is present, the job board uses
# only those. (_1.._10 numbered and comma-separated JOBS_GEMINI_API_KEYS
# forms work, same as the career keys.)
JOBS_GEMINI_API_KEY=
#
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIMENSIONS=768

# --- Resume parsing ---------------------------------------------------------
# "Drop your resume, see your jobs": a PDF resume is parsed by Gemini into
# skills, experience level and education, reviewed by the student, and used to
# fill the search form. The file is parsed in memory and discarded — only the
# extraction is stored (jobboard_resumes), and the student can delete it.
# Runs on the same keys as embeddings (JOBS_GEMINI_* when set, shared
# otherwise). Both caps below are defaults; parses are also limited to 5 per
# student per day.
# JOBS_RESUME_MODEL=gemini-flash-latest
# JOBS_RESUME_FALLBACK_MODEL=gemini-flash-lite-latest
# JOBS_RESUME_MONTHLY_LIMIT=300
