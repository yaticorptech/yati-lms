# ─── YATICORP LMS — server environment ───────────────────────────────────────
# Copy to .env for local development, and set the same keys in your host's
# environment settings for production. Never commit the real .env.

# ─── Core (required) ─────────────────────────────────────────────────────────
PORT=5000
# Full connection string INCLUDING the database name at the end.
# The db name matters: pointing at a non-existent name silently creates an
# empty database and every login will fail with "invalid credentials".
MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/yati_lms"
# Long random string. Changing it invalidates every issued login token.
JWT_SECRET=<random-64-char-string>

# ─── CORS (required in production) ───────────────────────────────────────────
# The deployed frontend URLs. A mismatch here blocks every API call from the
# browser. No trailing slash. localhost is always allowed automatically.
FRONTEND_URL=https://<student-app>.vercel.app
ADMIN_URL=https://<admin-app>.vercel.app
# Optional extra origins, comma-separated (custom domains, preview URLs).
ALLOWED_ORIGINS=https://<student-app>.vercel.app,https://<admin-app>.vercel.app

# ─── Sync webhook (STRONGLY recommended) ─────────────────────────────────────
# Shared secret for POST /api/sync/activate, which creates active users and
# enrollments. While this is UNSET the endpoint accepts unauthenticated
# requests from anyone. Set it here AND make the main website send the same
# value as an `x-sync-key` header — set it in only one place and activations
# will start failing with 401.
SYNC_API_KEY=

# ─── Email (Brevo) ───────────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
ADMIN_EMAIL=

# ─── Media / storage ─────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_CDN_HOST=
BUNNY_STORAGE_HOST=

# Max size (MB) for a lesson video/PDF upload. Default 5120 (5 GB).
MAX_LESSON_UPLOAD_MB=

# ─── Video DRM ───────────────────────────────────────────────────────────────
VDOCIPHER_API_KEY=

# ─── CAREER PATH (FuturePath) ────────────────────────────────────────────────
# The student-only AI career-roadmap section at /api/career. Ported from the
# standalone FuturePath app; it reuses the LMS student login and MONGO_URI, so
# these are the only extra variables it needs.

# Google Gemini. Required — roadmaps, daily tasks, lessons and the AI mentor all
# fail without it. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Free-tier quota is per-day PER MODEL: the newest flash models allow
# only ~20 requests/day and a single onboarding costs 3, so the default here is
# the far more generous lite model. Override only if you have billing enabled.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional but worth setting. Without it, a task lesson links out to a YouTube
# SEARCH instead of embedding a video the student can watch in place — the
# lesson still works, it is just a worse one. Free: enable the YouTube Data API
# v3 at https://console.cloud.google.com/apis/library/youtube.googleapis.com
# and create an API key. The server logs a warning at startup while it is unset.
YOUTUBE_API_KEY=

# ─── Career Path AI budget ───────────────────────────────────────────────────
# The Gemini free tier is metered per day, per model. One onboarding costs three
# calls, so a cohort arriving together can spend the day's allowance before
# anyone asks the mentor a question. These caps make that failure bounded and
# honest rather than sudden and total — they are not a substitute for billing.

# Per student, per day. Generous enough for onboarding plus a full day of
# planning and mentoring. Raise it if the admin Career Path page shows students
# hitting it while doing normal work.
CAREER_AI_DAILY_PER_STUDENT=30

# Whole-service ceiling per day. 0 disables it, which is the default: a wrong
# number here locks out every student at once, and the right number depends on
# a billing plan only you know.
CAREER_AI_DAILY_TOTAL=0

# Where this API is reachable from the public internet. Used to build Career
# Path milestone-badge share links (/b/<code>), which students post to LinkedIn
# and WhatsApp. Falls back to the request's forwarded host, which is usually
# right — but a share link is permanent, so set this explicitly in production.
# No trailing slash. e.g. https://api.yaticorp.com
PUBLIC_API_URL=
